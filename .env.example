# ---- Model providers (set at least one) ----
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# ---- Server ----
PORT=4111
MASTRA_HOST=0.0.0.0
LOG_LEVEL=info

# Path to the built Studio SPA. Set by the Dockerfile in production;
# only needed locally if you run the built output by hand.
# MASTRA_STUDIO_PATH=.mastra/output/studio

# ---- Storage ----
# Local file DB. Point at a mounted volume in production.
MASTRA_DB_URL=file:./data/mastra.db
# MASTRA_DB_AUTH_TOKEN=          # only for remote Turso/libSQL

# ---- Security ----
# Optional app-level auth. When set, Studio shows a login screen and every
# /api/* call needs `Authorization: Bearer <key>`. Leave blank to rely only on
# the Traefik basic-auth in front of the domain.
MASTRA_API_KEY=

# Comma-separated list of allowed origins. Lock this down once you know which
# frontends call the API. Default "*" is fine while the domain is behind auth.
MASTRA_CORS_ORIGIN=*

# ---- Timeouts (ms) ----
MASTRA_REQUEST_TIMEOUT=180000
MASTRA_DRAIN_TIMEOUT=30000

# ---- Dev conveniences (keep false in production) ----
MASTRA_SWAGGER_UI=false
MASTRA_OPENAPI=false
MASTRA_API_REQ_LOGS=false
MASTRA_TELEMETRY_DISABLED=1
